---
import { withBase } from '../../lib/paths';
import { getCollection } from 'astro:content';
import Base from '../../layouts/Base.astro';
import SectionTitle from '../../components/SectionTitle.astro';
import SourceList from '../../components/SourceList';
import { loadDataset } from '../../lib/load';
import { displayCompanyName, getPersonView } from '../../lib/data';
import { displayRoleTitle, rolePeriodLabel, roleStatusLabel } from '../../lib/labels';

export async function getStaticPaths() {
  const entries = await getCollection('people');
  return entries.map((entry) => ({ params: { id: entry.id } }));
}

const ds = await loadDataset();
const view = getPersonView(ds, Astro.params.id);
const { person, roles } = view;
const productName = (id: string) => ds.products.find((p) => p.id === id)?.name ?? id;
---

<Base title={person.name} description={person.bio}>
  <section class="relative overflow-hidden px-6 pb-20 pt-32 sm:px-10">
    <div class="mx-auto max-w-3xl">
      <p class="text-xs tracking-[0.3em] text-mist">人物</p>
      <h1 class="mt-4 font-serif text-5xl text-ink sm:text-6xl">{person.name}</h1>
      {person.aliases.length > 0 && (
        <p class="mt-3 text-sm text-mist">{person.aliases.join(' / ')}</p>
      )}
      {!person.verified && <span class="unverified mt-4 inline-block">待核实</span>}
      <p class="mt-8 font-serif text-lg leading-relaxed text-ink-soft">{person.bio}</p>
      {(person.linkedin || person.maimai || person.weibo) && (
        <p class="mt-6 flex flex-wrap gap-4 text-sm text-mist">
          {person.linkedin && (
            <a href={person.linkedin} target="_blank" rel="noreferrer" class="underline decoration-ink/20 underline-offset-4 transition hover:text-rouge">
              LinkedIn
            </a>
          )}
          {person.maimai && (
            <a href={person.maimai} target="_blank" rel="noreferrer" class="underline decoration-ink/20 underline-offset-4 transition hover:text-rouge">
              脉脉
            </a>
          )}
          {person.weibo && (
            <a href={person.weibo} target="_blank" rel="noreferrer" class="underline decoration-ink/20 underline-offset-4 transition hover:text-rouge">
              微博
            </a>
          )}
        </p>
      )}
    </div>
  </section>

  <section class="mx-auto max-w-3xl px-6 py-24 sm:px-10">
    <SectionTitle index="01" title="履历" note={`${roles.length} 段`} />
    <ol class="mt-12 space-y-10">
      {roles.map((role) => (
        <li class="border-t border-ink/15 pt-6">
          <p class="font-display text-xs tracking-wide text-mist">{rolePeriodLabel(role)} · {roleStatusLabel(role)}</p>
          <p class="mt-2 font-serif text-xl text-ink">{displayRoleTitle(role)}</p>
          <p class="mt-2 text-sm text-ink-soft">
            <a href={withBase(`/company/${role.company}`)} class="underline decoration-ink/20 underline-offset-4 transition hover:text-rouge">
              {displayCompanyName(ds, role.company)}
            </a>
            {role.scope === 'product' && role.products.length > 0 && (
              <span>
                {' · '}
                {role.products.map((id, i) => (
                  <>
                    {i > 0 && '、'}
                    <a href={withBase(`/company/${role.company}#works`)} class="underline decoration-ink/20 underline-offset-4 transition hover:text-rouge">
                      《{productName(id)}》
                    </a>
                  </>
                ))}
              </span>
            )}
          </p>
          {role.note && <p class="mt-3 text-xs leading-relaxed text-mist">{role.note}</p>}
          {role.checkedAt && <p class="mt-2 text-xs text-mist">最近核实：{role.checkedAt}</p>}
          {role.sources && <div class="mt-3"><SourceList sources={role.sources} /></div>}
        </li>
      ))}
    </ol>
    <div class="mt-16">
      <SourceList sources={person.sources} />
    </div>
  </section>
</Base>
