---
import Base from '../layouts/Base.astro';
import Bookshelf from '../components/Bookshelf';
import { chronicles, selectChronicle } from '../lib/chronicles';
import { loadDataset } from '../lib/load';
import { yearOf } from '../lib/dates';
import { withBase } from '../lib/paths';
const ds = await loadDataset();
const books = chronicles.map(volume => {
  const data = selectChronicle(ds, volume.id);
  return { ...volume, companies: data.companies.length, products: data.products.length,
    firstYear: data.companies.length ? Math.min(...data.companies.map(c => yearOf(c.founded))) : null };
});
---
<Base title="编年史合集" description="以一本本编年史，记录中国游戏公司的产品、团队与发展。">
  <section class="library-room mx-auto max-w-6xl px-6 pt-32 pb-14 sm:px-10">
    <div class="library-heading">
      <div>
        <p class="font-display text-sm tracking-[0.35em] text-mist">THE GAME CHRONICLES</p>
        <h1 class="mt-5 font-serif text-4xl leading-relaxed sm:text-5xl">游戏公司<br /><span class="text-ink-soft">编年史合集</span></h1>
      </div>
      <p class="library-intro font-serif text-sm leading-loose text-ink-soft">把公司的起点、作品的诞生与人的故事，<br class="hidden sm:block" />收进一本本持续生长的编年史。</p>
    </div>
    <Bookshelf client:load books={books} />
    <div class="library-footnote">
      <span>已上架 {books.length} 卷 · 持续编目</span>
      <a href={withBase('/chronicle/female/')}>女性向卷</a>
      <a href={withBase('/chronicle/casual/')}>休闲卷</a>
      <a href={withBase('/chronicle/slg/')}>SLG卷</a>
    </div>
  </section>
</Base>
<style>
  .library-heading{display:flex;align-items:flex-end;justify-content:space-between;gap:32px;max-width:860px;margin:0 auto 12px}
  .library-intro{padding-bottom:12px}
  .library-footnote{display:flex;flex-wrap:wrap;gap:24px;align-items:center;max-width:860px;margin:22px auto 0;padding-top:22px;border-top:1px solid #1e1a1715;font-size:11px;color:var(--color-mist)}
  .library-footnote span{margin-right:auto}.library-footnote a:hover{color:var(--color-rouge)}
  @media(max-width:640px){.library-heading{display:block;margin-bottom:20px}.library-intro{margin-top:12px}.library-footnote{gap:14px}}
</style>
