---
import '@fontsource/noto-serif-sc/500.css';
import '@fontsource/noto-serif-sc/700.css';
import '@fontsource/noto-sans-sc/400.css';
import '@fontsource/noto-sans-sc/500.css';
import '@fontsource/cormorant-garamond/500.css';
import '@fontsource/cormorant-garamond/600.css';
import '../styles/global.css';
import { withBase } from '../lib/paths';

interface Props {
  title: string;
  description?: string;
}

const { title, description = '中国游戏公司编年史合集' } = Astro.props;
const path = Astro.url.pathname.slice(withBase('/').length - 1);
---

<!doctype html>
<html lang="zh-CN">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <title>{title} · 游戏编年史合集</title>
  </head>
  <body class="min-h-screen bg-paper font-sans text-ink antialiased">
    <header class="absolute inset-x-0 top-0 z-40">
      <div class="mx-auto flex max-w-6xl items-center justify-between px-6 py-6 sm:px-10">
        <a href={withBase('/')} class="font-serif text-base tracking-[0.2em] text-ink">游戏编年史合集</a>
        <nav class="flex flex-wrap justify-end gap-x-5 gap-y-2 text-xs text-ink-soft sm:text-sm">
          <a href={withBase('/')} class:list={['transition hover:text-rouge', path === '/' && 'text-rouge']}>书架</a>
          <a href={withBase('/chronicle/female/')} class:list={['transition hover:text-rouge', path.startsWith('/chronicle/female') && 'text-rouge']}>女性向</a>
          <a href={withBase('/chronicle/casual/')} class:list={['transition hover:text-rouge', path.startsWith('/chronicle/casual') && 'text-rouge']}>休闲</a>
          <a href={withBase('/chronicle/slg/')} class:list={['transition hover:text-rouge', path.startsWith('/chronicle/slg') && 'text-rouge']}>SLG</a>
          <a href={withBase('/compare')} class:list={['transition hover:text-rouge', path.startsWith('/compare') && 'text-rouge']}>对比</a>
          <a href={withBase('/mapping/')} class:list={['transition hover:text-rouge', path.startsWith('/mapping') && 'text-rouge']}>研究进度</a>
        </nav>
      </div>
    </header>
    <main>
      <slot />
    </main>
    <footer class="border-t border-ink/10">
      <div class="mx-auto max-w-6xl px-6 py-10 text-xs leading-relaxed text-ink-soft sm:px-10">
        <p>资料整理自公开来源，仅供个人学习。流水数据多为第三方估算，以页面标注为准。</p>
      </div>
    </footer>
  </body>
</html>
