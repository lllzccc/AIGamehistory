---
import type { Company } from '../lib/types';
import { researchDirections, hasDeepCoverage } from '../lib/researchChecklist';
interface Props { company: Company }
const { company } = Astro.props;
const checklist = company.researchChecklist;
const accepted = checklist?.items.filter(i => i.status === 'reviewed').length ?? 0;
const deep = hasDeepCoverage(checklist);
const dates = checklist ? [...checklist.items.flatMap(i => i.checkedAt ? [i.checkedAt] : []), ...checklist.supplementRounds.map(r => r.checkedAt)].sort() : [];
const lastDate = dates.at(-1);
const stateLabels = { pending: '清单待核查', partial: '已查部分 · 未验收', reviewed: '本方向已验收' };
const gapLabels = { pending: '尚未检索', 'not-found': '已检索 · 暂未找到', conflicting: '证据不足或冲突', unavailable: '来源失效 · 无法核对', 'access-needed': '需访问条件或人工协助' };
const gaps = checklist?.items.flatMap(i => i.gaps) ?? [];
---
<section id="research" class="mx-auto max-w-6xl px-6 pt-16 sm:px-10">
  <div class="flex flex-wrap items-start justify-between gap-5 border-b border-ink/15 pb-6">
    <div><p class="text-xs tracking-widest text-mist">公开资料 · 覆盖范围与缺口</p><h2 class="mt-3 font-serif text-3xl text-ink">深挖清单</h2></div>
    <div class="text-left sm:text-right"><p class="text-sm text-rouge">{deep ? '深度收录 · 本轮已验收' : checklist ? '持续补全 · 尚未达到深度收录标准' : '尚未完成覆盖范围核查'}</p><p class="mt-2 text-xs text-mist">{accepted}/5 个方向已验收{lastDate && ` · 核查截至 ${lastDate}`}</p></div>
  </div>
  <p class="mt-5 max-w-3xl text-sm leading-relaxed text-ink-soft">展开每个方向，查看验收要求、实际查过的材料，以及下一步还可以挖什么。验收反映已核查的公开来源范围，不代表全网信息已被穷尽。</p>
  {!checklist && <p class="mt-3 text-xs leading-relaxed text-mist">这家公司已有内容尚未逐项映射到验收清单；“待核查”不表示此前没有检索。</p>}
  <label class="mt-6 flex flex-wrap items-center gap-3 text-xs text-mist">查看缺口
    <select data-gap-filter aria-label="筛选深挖缺口" class="max-w-full border border-ink/15 bg-paper px-3 py-2 text-ink-soft">
      <option value="">全部缺口（{gaps.length}）</option>
      {Object.entries(gapLabels).map(([key,label]) => <option value={key}>{label}（{gaps.filter(g => g.status === key).length}）</option>)}
    </select>
  </label>
  <div class="mt-5 divide-y divide-ink/15 border-y border-ink/15">
    {researchDirections.map(direction => {
      const item = checklist?.items.find(i => i.area === direction.area);
      return <details data-research-direction class="group py-5" open={direction.area === 'catalog' && !!checklist}>
        <summary class="cursor-pointer marker:text-mist focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-rouge"><span class="inline-flex w-[calc(100%-1.5rem)] flex-wrap items-baseline justify-between gap-2"><span class="font-serif text-xl text-ink">{direction.title}</span><span class="text-xs text-mist">{stateLabels[item?.status ?? 'pending']} · {item?.gaps.length ?? 0} 项待深挖</span></span></summary>
        <div class="pt-5 sm:pl-5">
          <p class="text-xs text-mist">验收要求</p><p class="mt-2 max-w-3xl text-sm leading-relaxed text-ink-soft">{direction.criterion}</p>
          <p class="mt-5 text-xs text-mist">当前覆盖范围{item?.checkedAt && ` · ${item.checkedAt}`}</p><p class="mt-2 max-w-3xl text-sm leading-relaxed text-ink-soft">{item?.scope ?? '本方向尚未完成清单核查，先对照现有内容与来源，再逐项补检。'}</p>
          {!!item?.examined.length && <details class="mt-4 text-xs"><summary class="cursor-pointer text-mist">实际检查的来源（{item.examined.length}）</summary><ul class="mt-3 max-w-3xl space-y-4">{item.examined.map(e => <li><a href={e.source.url} target="_blank" rel="noopener noreferrer" class="text-ink-soft underline underline-offset-4">{e.source.title} ↗</a><p class="mt-1 leading-relaxed text-mist">{e.note}</p></li>)}</ul></details>}
          {!!item?.gaps.length && <div class="mt-6"><h3 class="font-serif text-base text-ink">下一步深挖</h3><ul class="mt-3 max-w-3xl divide-y divide-ink/10">{item.gaps.map(gap => <li data-research-gap data-gap-status={gap.status} class="py-4"><span class="text-xs text-rouge">{gapLabels[gap.status]}</span><p class="mt-2 text-sm text-ink">{gap.question}</p><p class="mt-2 text-sm leading-relaxed text-ink-soft">{gap.nextStep}</p>{gap.sources.length > 0 && <p class="mt-2 flex flex-wrap gap-x-4 gap-y-2 text-xs text-mist">{gap.sources.map(s => <a href={s.url} target="_blank" rel="noopener noreferrer" class="underline underline-offset-4">{s.title} ↗</a>)}</p>}</li>)}</ul><p data-direction-empty hidden class="mt-4 text-xs text-mist">这个方向没有符合筛选条件的缺口。</p></div>}
        </div>
      </details>;
    })}
  </div>
  <details class="mt-5 text-xs text-mist"><summary class="cursor-pointer">怎样判断一轮深挖达标？</summary><p class="mt-3 max-w-3xl leading-relaxed">五个方向的主要来源都检查完，发现的条目都已收录或写明处理理由，剩余缺口有检索记录。随后再做两轮不同渠道的补漏检索；连续两轮没有新增关键事实，才验收这一版。重复转载、普通宣传不计为新增关键事实。</p><p class="mt-3">补漏轮次已记录：{checklist?.supplementRounds.length ?? 0} 轮。</p>{checklist?.supplementRounds.map(r => <p class="mt-3">{r.checkedAt} · {r.channel} · {r.foundKeyFacts ? '发现新关键事实，继续追查' : '未发现新关键事实'} · {r.note} {r.sources.map(s => <a href={s.url} target="_blank" rel="noopener noreferrer" class="underline">{s.title} ↗</a>)}</p>)}</details>
</section>
<script>
  const root = document.querySelector('#research');
  const filter = root?.querySelector<HTMLSelectElement>('[data-gap-filter]');
  filter?.addEventListener('change', () => {
    root?.querySelectorAll<HTMLDetailsElement>('[data-research-direction]').forEach(direction => {
      const rows = direction.querySelectorAll<HTMLElement>('[data-research-gap]');
      let visible = 0;
      rows.forEach(row => { row.hidden = !!filter.value && row.dataset.gapStatus !== filter.value; if (!row.hidden) visible++; });
      const empty = direction.querySelector<HTMLElement>('[data-direction-empty]');
      if (empty) empty.hidden = visible > 0;
      if (filter.value && visible > 0) direction.open = true;
    });
  });
</script>
