---
import type { Company } from '../lib/types';
import ResearchChecklist from './ResearchChecklist.astro';
interface Props { company: Company }
const { company } = Astro.props;
const financials = company.financials ?? [];
const annuals = financials.filter(f => !f.period.includes('-')).sort((a,b) => a.period.localeCompare(b.period));
const interims = financials.filter(f => f.period.includes('-')).sort((a,b) => a.period.localeCompare(b.period));
const max = Math.max(1, ...annuals.map(f => f.revenueCNY));
const money = (n: number) => (n / 100000000).toFixed(3);
---
<ResearchChecklist company={company} />
{financials.length > 0 && <section id="financials" class="mx-auto max-w-6xl px-6 pt-20 sm:px-10">
  <h2 class="font-serif text-2xl text-ink">经营账页</h2>
  <p class="mt-3 max-w-3xl text-sm leading-relaxed text-ink-soft">集团合并财报 · 人民币亿元。收益包含多个产品及地区，不能当作单款游戏流水；利润采用财报的年内／期内利润，保留亏损。半年与全年分开展示。</p>
  <p class="mt-4 text-xs text-mist sm:hidden">左右滑动账页，查看利润与财报来源 →</p>
  {annuals.length > 0 && <div class="mt-8 overflow-x-auto"><table class="w-full min-w-[34rem] text-left text-sm">
    <caption class="pb-4 text-left text-xs tracking-widest text-mist">年度 · 1月1日至12月31日</caption>
    <thead class="border-b border-ink/15 text-xs text-mist"><tr><th class="py-3 font-normal">年份</th><th class="font-normal">合并收益</th><th class="font-normal">年内利润／亏损</th><th class="font-normal">官方来源</th></tr></thead>
    <tbody>{annuals.map(f => <tr class="border-b border-ink/10"><th class="py-5 font-display text-xl font-normal">{f.period}</th><td class="w-[40%] pr-8"><span class="tabular-nums">{money(f.revenueCNY)}</span><span class="mt-2 block h-1 bg-ink/5"><span class="block h-full bg-rouge/50" style={`width:${f.revenueCNY/max*100}%`}></span></span></td><td class:list={['tabular-nums', { 'text-rouge': (f.profitCNY ?? 0) < 0 }]}>{f.profitCNY === undefined ? '未收录' : money(f.profitCNY)}</td><td><a href={f.source.url} title={f.source.title} target="_blank" rel="noopener noreferrer" class="text-xs text-mist underline underline-offset-4">财报 ↗</a></td></tr>)}</tbody>
  </table></div>}
  {interims.length > 0 && <div class="mt-10 overflow-x-auto"><table class="w-full min-w-[34rem] text-left text-sm">
    <caption class="pb-4 text-left text-xs tracking-widest text-mist">半年度 · 不与全年直接比较</caption>
    <thead class="border-b border-ink/15 text-xs text-mist"><tr><th class="py-3 font-normal">期间</th><th class="font-normal">合并收益</th><th class="font-normal">期内利润／亏损</th><th class="font-normal">官方来源</th></tr></thead>
    <tbody>{interims.map(f => <tr class="border-b border-ink/10"><th class="py-5 font-normal">{f.period.replace('-H1', ' 上半年').replace('-H2', ' 下半年')}</th><td class="w-[40%] tabular-nums">{money(f.revenueCNY)}</td><td class="tabular-nums">{f.profitCNY === undefined ? '未收录' : money(f.profitCNY)}</td><td><a href={f.source.url} title={f.source.title} target="_blank" rel="noopener noreferrer" class="text-xs text-mist underline underline-offset-4">财报 ↗</a></td></tr>)}</tbody>
  </table></div>}
</section>}
