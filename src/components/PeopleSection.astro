---
import { withBase } from '../lib/paths';
import type { Company, CompanyPerson } from '../lib/types';
import { displayRoleTitle, rolePeriodLabel, roleStatusLabel } from '../lib/labels';
import SectionTitle from './SectionTitle.astro';
import SourceLinks from './SourceLinks';

interface Props {
  index: string;
  people: CompanyPerson[];
  companies: Company[];
}

const { index, people, companies } = Astro.props;
const nameOf = (id: string) => companies.find((c) => c.id === id)?.name ?? id;
const management = people.filter((entry) => entry.roles.some((r) => r.scope === 'company'));
---

{management.length > 0 && (
  <section class="mx-auto max-w-6xl px-6 py-24 sm:px-10">
    <SectionTitle index={index} title="关键人物" note="最高层" />
    <ul class="mt-12 grid gap-x-8 gap-y-12 sm:grid-cols-2 lg:grid-cols-3">
      {management.map((entry) => (
        <li class="border-t border-ink/15 pt-6">
          <div class="flex items-center gap-4">
            {entry.person.avatar ? (
              <img src={entry.person.avatar} alt="" class="h-14 w-14 rounded-full object-cover grayscale" />
            ) : (
              <span class="flex h-14 w-14 items-center justify-center rounded-full bg-rouge-soft font-serif text-xl text-rouge">
                {entry.person.name.slice(0, 1)}
              </span>
            )}
            <div>
              <a href={withBase(`/person/${entry.person.id}`)} class="font-serif text-lg text-ink transition hover:text-rouge">
                {entry.person.name}
              </a>
              {entry.roles
                .filter((r) => r.scope === 'company')
                .map((role) => (
                  <p class="text-sm text-ink-soft">
                    {displayRoleTitle(role)}
                    <span class="ml-2 font-display text-mist">{rolePeriodLabel(role)} · {roleStatusLabel(role)}</span>
                  </p>
                ))}
            </div>
          </div>
          <p class="mt-4 text-sm leading-relaxed text-ink-soft">{entry.person.bio}</p>
          {entry.elsewhere.length > 0 && (
            <p class="mt-3 text-xs leading-relaxed text-mist">
              亦曾任职：
              {entry.elsewhere.map((role, i) => (
                <>
                  {i > 0 && '、'}
                  <a href={withBase(`/company/${role.company}`)} class="text-rouge hover:underline">{nameOf(role.company)}</a>
                  <span class="ml-1">{displayRoleTitle(role)}</span>
                </>
              ))}
            </p>
          )}
          <p class="mt-3 flex flex-wrap items-center gap-x-2 text-xs text-mist">
            <SourceLinks sources={entry.person.sources} />
            {!entry.person.verified && <span class="unverified">待核实</span>}
          </p>
        </li>
      ))}
    </ul>
  </section>
)}
